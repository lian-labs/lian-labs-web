# Production domain, no trailing slash. Used for canonical URLs, sitemap,
# Open Graph images and structured data.
NEXT_PUBLIC_SITE_URL=https://et.lian-labs.com

# Set to 1 on staging deployments to keep them out of search engines.
NEXT_PUBLIC_NOINDEX=

# Optional analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
